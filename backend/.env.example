# Database Configuration (NOT USED: the app always uses the SQLite file technical_interviewer.db)
DATABASE_URL=postgresql://user:password@localhost:5432/technical_interviewer

# Application Settings
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ENVIRONMENT=development

# OpenAI Configuration (for later phases)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Voice/Video Configuration (for later phases)
VOICE_PROVIDER=mock

# Logging
LOG_LEVEL=INFO

# Demo-only interviewer gate (not production authentication)
INTERVIEWER_PASSCODE=change-me

# Retention policy (days after completion). A policy value only: nothing is deleted automatically.
DATA_RETENTION_DAYS=180

